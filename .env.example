# CodeLlama Configuration (Local Model)
# Download CodeLlama model to ./models/codellama-34b-instruct/
# From: https://huggingface.co/codellama/CodeLlama-34b-Instruct-hf
CODELLAMA_MODEL_PATH=./models/codellama-34b-instruct

# Optional: OpenAI Configuration (if switching providers)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4

# Optional: Claude (Anthropic) Configuration (if switching providers)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-3-sonnet-20240229

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Data Paths
CORPUS_PATH=./data/corpus/raw
VECTOR_DB_PATH=./data/vector_db
